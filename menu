#!/bin/bash
CONFIG="$HOME/.winqemu.conf"
source "$CONFIG" 2>/dev/null || { RAM=2560; CPU_CORES=4; DISK="win10-auto.qcow2"; }

DISKS_DIR="$HOME/win-qemu/disks"
ISOS_DIR="$HOME/win-qemu/isos"
SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)/scripts"
QEMU_CMD="qemu-system-x86_64"
MONITOR_SOCK="$(dirname "$0")/monitor.sock"
QMP_SOCK="$(dirname "$0")/qmp.sock"
BASE_DIR="$(cd "$(dirname "$0")" && pwd)"

check_vm_running() {
    pgrep -x $QEMU_CMD >/dev/null
}

wait_for_desktop() {
    echo "Waiting for Windows to boot (this may take several minutes)..."
    local i=0
    while [ $i -lt 20 ]; do
        sleep 25
        # Use python to get brightness and avoid bc dependency
        local bright=$(python3 -c "
import socket, time
from PIL import Image, ImageStat
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(4)
    s.connect('$MONITOR_SOCK')
    s.recv(4096)
    s.settimeout(10)
    s.send(b'screendump /tmp/winqemu_bright.ppm\n')
    time.sleep(3)
    s.close()
    img = Image.open('/tmp/winqemu_bright.ppm').convert('L')
    w, h = img.size
    bright = 100 * ImageStat.Stat(img).mean[0] / 255
    print(f'{bright:.1f}')
except:
    print('')
" 2>/dev/null)
        if [ -n "$bright" ]; then
            if [ $(echo "$bright > 40" | python3 -c "import sys; print(1 if float(sys.stdin.read()) > 40 else 0)" 2>/dev/null || echo 0) -eq 1 ]; then
                echo "✅ Desktop ready (brightness: $bright%)"
                return 0
            fi
        fi
        i=$((i+1))
    done
    echo "⚠️  Boot timeout. Check manually."
    return 1
}

# Pastikan folder & subfolder ada (buat otomatis kalau belum)
ensure_dirs() {
    mkdir -p "$HOME/win-qemu/disks" "$HOME/win-qemu/isos" "$HOME/win-qemu/transfer"
}

# Pilih disk dari folder. Kalau kosong, beri panduan & buka folder.
pick_disk() {
    ensure_dirs
    local win_disks=() linux_isos=()
    # Disk .qcow2 (Windows/OS terinstall)
    while IFS= read -r f; do
        [ -f "$f" ] && win_disks+=("$(basename "$f")" "$(du -h "$f" | cut -f1)")
    done < <(ls -1 "$DISKS_DIR"/*.qcow2 2>/dev/null)
    # File ISO (installer / live) — Linux/OS lain
    while IFS= read -r f; do
        [ -f "$f" ] && linux_isos+=("$(basename "$f")" "$(du -h "$f" | cut -f1)")
    done < <(ls -1 "$ISOS_DIR"/*.iso 2>/dev/null)

    if [ $(( ${#win_disks[@]} + ${#linux_isos[@]} )) -eq 0 ]; then
        dialog --title "Tidak ada disk/ISO" --msgbox \
"Tidak ada file disk (.qcow2) atau installer (.iso).

Letakkan filenya di:
  disk:  ~/win-qemu/disks/
  ISO:   ~/win-qemu/isos/

Atau pakai menu 'Import dari Download' untuk otomatis
menyalin file dari folder Download HP kamu." 10 60
        return 1
    fi

    # Susun menu per kelompok (Windows duluan, lalu Linux/ISO)
    local menu_items=()
    if [ ${#win_disks[@]} -gt 0 ]; then
        menu_items+=("[ Windows ]" "OS yang sudah terinstal")
        menu_items+=("${win_disks[@]}")
    fi
    if [ ${#linux_isos[@]} -gt 0 ]; then
        menu_items+=("[ Linux / ISO ]" "Installer atau Live")
        menu_items+=("${linux_isos[@]}")
    fi

    # Kalau cuma 1 pilihan nyata, langsung pakai (lewatkan header)
    local real_count=$(( (${#win_disks[@]} + ${#linux_isos[@]}) / 2 ))
    if [ "$real_count" -eq 1 ]; then
        [ ${#win_disks[@]} -gt 0 ] && echo "${win_disks[0]}" && return 0
        echo "${linux_isos[0]}" && return 0
    fi

    # banyak file, biarkan user memilih (header jadi pilihan yang dilewati)
    local sel
    sel=$(dialog --title "Pilih File" --menu "Pilih sistem (Windows / Linux / ISO):" 18 62 12 \
        "${menu_items[@]}" 2>&1 >/dev/tty)
    case "$sel" in
        "[ Windows ]"|"[ Linux / ISO ]") sel="" ;;  # header bukan file nyata
    esac
    [[ "$sel" == *".qcow2" || "$sel" == *".iso" ]] && echo "$sel" || echo ""
}

# Buat disk kosong baru (format qcow2). Echo nama file jika berhasil.
create_new_disk() {
    ensure_dirs
    ds_sz=$(dialog --title "Ukuran Disk" --menu \
"Pilih ukuran disk baru (dipakai untuk install OS):" 12 50 5 \
         "8"  "8 GB  - Linux ringan" \
         "15" "15 GB - rekomendasi / Linux + Windows ringan" \
         "30" "30 GB - Windows / banyak ruang" \
         2>&1 >/dev/tty)
    [ -z "$ds_sz" ] && return ""
    read -r -p "Nama disk baru (contoh: linux-01): " nm < /dev/tty
    [ -z "$nm" ] && return ""
    local f="$DISKS_DIR/$nm.qcow2"
    dialog --infobox "Membuat disk ${ds_sz}GB...\n$nm.qcow2\n\nMohon tunggu." 6 40
    if qemu-img create -f qcow2 "$f" "${ds_sz}G" >/dev/null 2>&1; then
        dialog --msgbox "✅ Disk dibuat:\n\n$nm.qcow2 (${ds_sz} GB)\n\nSekarang pilih disk ini untuk install OS." 8 55
        echo "$nm.qcow2"
    else
        dialog --msgbox "❌ Gagal membuat disk. Periksa penyimpanan." 6 55
        return ""
    fi
}

# Pilih disk untuk sebuah ISO (installer). Tampilkan disk yang ada + opsi "I don't have disk"
choose_disk_for_iso() {
    ensure_dirs
    # Guard anti-loop untuk re-kursi setelah import
    [ "$_CDI_DEPTH" = "1" ] && return ""
    _CDI_DEPTH=1
    local disks=()
    while IFS= read -r f; do
        [ -f "$f" ] && disks+=("$(basename "$f")" "$(du -h "$f" | cut -f1)")
    done < <(ls -1 "$DISKS_DIR"/*.qcow2 2>/dev/null)

    # Jika tidak ada disk sama sekali, langsung tanya buat/import
    if [ ${#disks[@]} -eq 0 ]; then
        dialog --title "Belum Ada Disk" --yesno \
"Belum ada disk untuk menginstall OS ini.
\nMau buat disk baru sekarang?" 7 50
        if [ $? -eq 0 ]; then
            newnm=$(create_new_disk)
            [ -n "$newnm" ] && echo "$newnm" && return 0
        else
            import_disk
        fi
        return 1
    fi

    # Ada disk: tampilkan daftar + opsi "I don't have disk"
    local menu_items=("${disks[@]}" "---" "Tidak punya disk...")
    local sel
    sel=$(dialog --title "Pilih Disk untuk OS ini" \
        --menu "\nPilih disk tempat OS mau diinstall,\natau pilih 'Tidak punya disk' untuk membuat/import." 16 62 8 \
        "${menu_items[@]}" 2>&1 >/dev/tty)
    [ -z "$sel" ] && return ""
    case "$sel" in
        "---") return "" ;;
        "Tidak punya disk...")
            cho=$(dialog --menu "Tidak Punya Disk" 12 55 5 \
                "create" "Buat disk baru (create new disk)" \
                "import" "Import disk dari Download" \
                2>&1 >/dev/tty)
            case "$cho" in
                create)
                    newnm=$(create_new_disk)
                    [ -n "$newnm" ] && echo "$newnm" && return 0
                    return ""
                    ;;
                import)
                    import_disk
                    # Import selesai. Kembalikan kosong; user akan disarankan
                    # memilih lagi disk barunya dari Start (anti-loop).
                    return ""
                    ;;
                *) return "" ;;
            esac
            ;;
        *) echo "$sel" ;;
    esac
}

start_vm() {
    local file="$1"
    ensure_dirs

    # Kalau file belum ditentukan, minta pilih (dari disk & isos)
    if [ -z "$file" ]; then
        file=$(pick_disk)
        [ -z "$file" ] && return
    fi

    if check_vm_running; then
        dialog --msgbox "VM is already running. Shutdown first." 6 50
        return
    fi
    
    # Cleanup sockets
    rm -f "$MONITOR_SOCK" "$QMP_SOCK"

    local FILE_PATH=""
    local TGT_DISK=""
    if [[ "$file" == *.iso ]]; then
        # ISO (installer): minta pilih/buat/import disk untuk install.
        # Tanpa disk terpilih, boot dibatalkan (agar tidak bingung).
        TGT_DISK=$(choose_disk_for_iso)
        if [ -z "$TGT_DISK" ]; then
            dialog --title "Disk Tidak Dipilih" --msgbox \
"Boot dibatalkan karena belum ada disk untuk install OS.

Pilih disk yang sudah ada, atau buat/import disk baru
lewat opsi di menu pemilihan disk." 8 55
            return
        fi
        FILE_PATH="$ISOS_DIR/$file"
        if [ ! -f "$FILE_PATH" ]; then
            dialog --msgbox "File tidak ditemukan: $FILE_PATH" 6 55
            return
        fi
    else
        # .qcow2: sudah jadi OS, langsung boot
        FILE_PATH="$DISKS_DIR/$file"
        if [ ! -f "$FILE_PATH" ]; then
            dialog --msgbox "File tidak ditemukan: $FILE_PATH" 6 55
            return
        fi
    fi

    # Start QEMU in background (pass target disk untuk ISO jika ada)
    cd "$BASE_DIR"
    if [ -n "$TGT_DISK" ]; then
        nohup setsid sh "$SCRIPTS_DIR/boot-fast.sh" "$FILE_PATH" "$DISKS_DIR/$TGT_DISK" > "$BASE_DIR/vm.log" 2>&1 </dev/null &
    else
        nohup setsid sh "$SCRIPTS_DIR/boot-fast.sh" "$FILE_PATH" > "$BASE_DIR/vm.log" 2>&1 </dev/null &
    fi
    
    wait_for_desktop
    if command -v vncviewer >/dev/null; then
        nohup env DISPLAY=:0 vncviewer -FullScreen=1 127.0.0.1:5901 >/dev/null 2>&1 &
    fi
}

shutdown_vm() {
    if check_vm_running; then
        # Send ACPI shutdown using python (avoid socat dependency)
        python3 -c "
import socket, time
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(4)
    s.connect('$MONITOR_SOCK')
    s.recv(4096)
    s.settimeout(8)
    s.send(b'system_powerdown\n')
    time.sleep(2)
    s.close()
    print('Shutdown signal sent')
except Exception as e:
    print('Error: ' + str(e))
" >/dev/null 2>&1
        dialog --msgbox "Shutdown signal sent. Wait a moment for VM to stop." 6 50
    else
        dialog --msgbox "VM is not running." 6 50
    fi
}

show_settings() {
    while true; do
        # Tampilkan RAM dalam GB biar gampang dibaca
        ram_gb=$(echo "scale=1; $RAM/1024" | bc 2>/dev/null || echo "$((RAM/1024)).$(( (RAM%1024)*10/1024 ))")
        # Deteksi RAM HP (host) untuk panduan
        host_ram=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%.0f", $2/1024/1024}')
        [ -z "$host_ram" ] && host_ram="?"

        choice=$(dialog --title "🖥️  Pengaturan Machine" \
            --menu "\nRAM HP kamu terdeteksi: ±${host_ram} GB\n\nPilih sistem operasi yang mau dijalankan, atau atur\nmanual. RAM guest tidak boleh melebihi RAM HP.\n\nSaat ini terpasang: RAM ${RAM} MB, $CPU_CORES core" 17 60 8 \
            1 "🪟  Preset Windows" \
            2 "🐧  Preset Linux (hemat RAM)" \
            3 "Atur RAM manual" \
            4 "Atur CPU Core manual" \
            5 "Ganti Disk" \
            6 "Panduan RAM & CPU" \
            0 "Kembali" \
            2>&1 >/dev/tty)
        
        case $choice in
            1)
                # Preset Windows: RAM otomatis sesuai RAM HP, CPU 4
                ls_pref=2048
                [ "$host_ram" -ge 12 ] && ls_pref=4096
                [ "$host_ram" -ge 8 ] && [ "$host_ram" -lt 12 ] && ls_pref=3072
                [ "$host_ram" -ge 6 ] && [ "$host_ram" -lt 8 ] && ls_pref=2560
                dialog --title "Preset Windows" --yesno \
"Pakai pengaturan standar untuk Windows?
Berikut disesuaikan otomatis dengan RAM HP kamu
(dideteksi ±${host_ram} GB):

  RAM: ${ls_pref} MB
  CPU: 4 core

Lanjut?" 11 55
                if [ $? -eq 0 ]; then
                    RAM=$ls_pref
                    CPU_CORES=4
                    dialog --msgbox "Preset Windows diterapkan:\n\nRAM: ${RAM} MB\nCPU: 4 core\n\nSekarang pilih disk Windows di 'Ganti Disk'\natau langsung 'Start'." 10 55
                fi
                ;;
            2)
                # Preset Linux: RAM & core hemat biar ringan
                dialog --title "Preset Linux (Ringan)" --yesno \
"Pakai pengaturan hemat RAM khusus untuk Linux?

Linux jauh lebih ringan dari Windows, jadi cukup
RAM kecil & core sedikit — biar HP tidak panas
dan emulator tetap jalan halus.

  RAM: 1536 MB (1.5 GB)
  CPU: 2 core

Lanjut?" 11 55
                if [ $? -eq 0 ]; then
                    RAM=1536
                    CPU_CORES=2
                    dialog --msgbox "Preset Linux diterapkan:\n\nRAM: 1536 MB\nCPU: 2 core\n\nSelanjutnya taruh ISO/disk Linux di Download\ndan pilih 'Import dari Download', lalu Start." 10 55
                fi
                ;;
            3)
                ram_choice=$(dialog --title "Atur RAM" \
                    --menu "\nSemakin besar RAM, semakin lancar Windows\ntapi semakin berat untuk HP. Pilih sesuai HP-mu:" 13 50 7 \
                    "1536" "1.5 GB - Linux / HP low-end" \
                    "2048" "2 GB  - HP low-end (4GB)" \
                    "2560" "2.5 GB - HP menengah (6GB)" \
                    "3072" "3 GB  - HP menengah-atas (8GB)" \
                    "3584" "3.5 GB - HP atas (8-12GB)" \
                    "4096" "4 GB  - HP flagship (12GB+)" \
                    2>&1 >/dev/tty)
                [ -n "$ram_choice" ] && RAM=$ram_choice
                ;;
            4)
                cpu_choice=$(dialog --title "Atur CPU Core" \
                    --menu "\nJumlah core yang dipinjamkan. Lebih banyak =\nlebih cepat, tapi HP makin panas.\nDisarankan 4 (pakai setengah core HP):" 13 50 8 \
                    "2" "2 core - hemat daya / Linux" \
                    "3" "3 core" \
                    "4" "4 core - rekomendasi Windows" \
                    "5" "5 core - HP game/8 core" \
                    "6" "6 core - HP kencang" \
                    2>&1 >/dev/tty)
                [ -n "$cpu_choice" ] && CPU_CORES=$cpu_choice
                ;;
            5)
                # List available disks (plus tombol Import)
                ensure_dirs
                disks=()
                for f in "$DISKS_DIR"/*.qcow2; do
                    [ -f "$f" ] && disks+=("$(basename "$f")" "")
                done
                if [ ${#disks[@]} -eq 0 ]; then
                    dialog --title "Ganti Disk" --yesno \
"Belum ada disk. Mau import dari folder Download sekarang?" 7 45
                    if [ $? -eq 0 ]; then
                        import_disk
                    fi
                else
                    disks+=("== Import dari Download ==" "")
                    new_disk=$(dialog --menu "Select disk" 15 50 6 "${disks[@]}" 2>&1 >/dev/tty)
                    if [ "$new_disk" = "== Import dari Download ==" ]; then
                        import_disk
                    elif [ -n "$new_disk" ]; then
                        DISK=$new_disk
                    fi
                fi
                ;;
            6) dialog --title "Panduan RAM & CPU" --msgbox \
"RAM Windows (guest):
 - HP 4GB  -> pilih 2GB
 - HP 6GB  -> pilih 2.5GB
 - HP 8GB  -> pilih 3GB
 - HP 12GB+ -> pilih 3.5-4GB
Sisakan minimal 2GB RAM untuk HP itu sendiri.

RAM Linux: cukup 1.5GB (gunakan Preset Linux).

CPU Cores:
 - Windows: 4-6 core (HP kencang) / 4 (aman)
 - Linux: 2 core sudah cukup (Preset Linux)
Lebih banyak core = lebih lancar tapi HP panas.

Tips: kalau makin dipakai makin nge-lag,
turunkan RAM & core sedikit." 16 55
                ;;
            *) break ;;
        esac
    done
    # Simpan config
    cat > "$CONFIG" << EOF
RAM=$RAM
CPU_CORES=$CPU_CORES
DISK=$DISK
EOF
}

tools_menu() {
    while true; do
        choice=$(dialog --menu "Tools" 15 50 5 \
            1 "Screenshot + OCR" \
            2 "Analyze Colors" \
            3 "Open Transfer Folder" \
            0 "Back" \
            2>&1 >/dev/tty)
        
        case $choice in
            1) python3 "$SCRIPTS_DIR/scr.py" -f full ;;
            2) 
                if check_vm_running; then
                    ppm="/tmp/winqemu_analyze.ppm"
                    python3 -c "
import socket, time
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(4)
s.connect('$MONITOR_SOCK')
s.recv(4096)
s.settimeout(8)
s.send(b'screendump $ppm\n')
time.sleep(3)
s.close()
" >/dev/null 2>&1
                    if [ -f "$ppm" ]; then
                        convert "$ppm" "/tmp/winqemu_analyze.png" >/dev/null 2>&1
                        python3 "$SCRIPTS_DIR/analyze.py" "/tmp/winqemu_analyze.png" 2>/dev/null | grep -v "px ="
                        read -p "Press Enter to continue..."
                    fi
                else
                    dialog --msgbox "VM is not running." 6 50
                fi
                ;;
            3) termux-open "$HOME/win-qemu/transfer/" 2>/dev/null || termux-open "$HOME/win-qemu/" ;;
            *) break ;;
        esac
    done
}

import_disk() {
    ensure_dirs
    # Sumber: folder Download (folder publik yang gampang diakses user)
    local src_dirs=(
        "$HOME/storage/downloads"
        "/storage/emulated/0/Download"
    )
    local found=()
    for d in "${src_dirs[@]}"; do
        [ -d "$d" ] || continue
        while IFS= read -r f; do
            [ -f "$f" ] && found+=("$f")
        done < <(ls -1 "$d"/*.qcow2 "$d"/*.iso 2>/dev/null)
    done

    if [ ${#found[@]} -eq 0 ]; then
        dialog --title "Import Disk" --msgbox \
"Tidak ada file .qcow2 / .iso di folder Download.

Cara pakai:
1. Download/buat file disk Windows (.qcow2) atau ISO Windows
2. Taruh di folder download HP kamu (biasanya: Internal Storage/Download)
3. Kembali ke menu lalu pilih 'Import dari Download'
4. File akan disalin otomatis ke folder yang benar" 12 60
        return
    fi

    # Tampilkan daftar file yang ditemukan untuk dipilih
    local list=()
    for f in "${found[@]}"; do
        list+=("$f" "$(du -h "$f" | cut -f1)")
    done
    local chosen
    chosen=$(dialog --title "Pilih File" --menu "File di Download:" 15 60 8 "${list[@]}" 2>&1 >/dev/tty)
    [ -z "$chosen" ] && return

    local base ext
    base=$(basename "$chosen")
    ext="${base##*.}"

    if [ "$ext" = "qcow2" ]; then
        local dest="$DISKS_DIR/$base"
        dialog --title "Import" --infobox "Menyalin disk...\n$base\n\nMohon tunggu, file besar butuh waktu." 6 40
        if [ -f "$dest" ]; then
            dialog --title "Sudah Ada" --yesno "File '$base' sudah ada di folder disk.\n\nTimpa dengan file baru ini?" 8 50
            [ $? -ne 0 ] && return
        fi
        cp "$chosen" "$dest" 2>/dev/null
        if [ -f "$dest" ]; then
            dialog --msgbox "✅ Selesai.\n\n'$base' sudah disalin ke folder disk.\nSekarang pilih 'Start Windows' untuk memakainya." 8 60
        else
            dialog --msgbox "❌ Gagal menyalin. Cek sisa penyimpanan dan izin storage." 6 55
        fi
    elif [ "$ext" = "iso" ]; then
        local dest="$HOME/win-qemu/isos/$base"
        dialog --title "Import" --infobox "Menyalin ISO...\n$base\n\nMohon tunggu, file besar butuh waktu." 6 40
        cp "$chosen" "$dest" 2>/dev/null
        if [ -f "$dest" ]; then
            dialog --msgbox "✅ Selesai.\n\n'$base' disalin ke isos/ (dipakai untuk install OS)." 7 55
        else
            dialog --msgbox "❌ Gagal menyalin. Cek sisa penyimpanan dan izin storage." 6 55
        fi
    else
        dialog --msgbox "Format file tidak didukung. Butuh .qcow2 atau .iso" 6 50
    fi
}

# Main menu
while true; do
    clear
    choice=$(dialog --title "AYSRAF PM v1.0" \
        --menu "Select an option" 18 60 10 \
        1 "Start VM (Windows / Linux)" \
        2 "Import dari Download" \
        3 "Shutdown VM" \
        4 "Machine (RAM & CPU)" \
        5 "Tools" \
        6 "Exit" \
        2>&1 >/dev/tty)
    
    case $choice in
        1) start_vm "" ;;
        2) import_disk ;;
        3) shutdown_vm ;;
        4) show_settings ;;
        5) tools_menu ;;
        *) clear; exit 0 ;;
    esac
done
